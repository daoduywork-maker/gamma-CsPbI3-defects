&CONTROL
  calculation   = 'vc-relax'
  prefix        = 'ref_Pb'
  outdir        = './tmp'
  pseudo_dir    = '/public/home/daomduy/cspbi3/pseudo_pbesol'
  etot_conv_thr = 1.0e-06
  forc_conv_thr = 4.0e-04
  nstep         = 200
  tprnfor       = .true.
  tstress       = .true.
/

&SYSTEM
  ibrav       = 0
  nat         = 1
  ntyp        = 1
  ecutwfc     = 60.0
  ecutrho     = 480.0
  occupations = 'smearing'
  smearing    = 'mv'
  degauss     = 0.01
/

&ELECTRONS
  conv_thr    = 1.0e-10
  mixing_beta = 0.3
  electron_maxstep = 300
/

&IONS
  ion_dynamics = 'bfgs'
/

&CELL
  cell_dynamics = 'bfgs'
  cell_dofree   = 'all'
  press_conv_thr = 0.2
/

ATOMIC_SPECIES
Pb   207.200  Pb.pbesol-dn-kjpaw_psl.0.2.2.UPF

CELL_PARAMETERS angstrom
      0.0000000000     2.4750000000     2.4750000000
      2.4750000000     0.0000000000     2.4750000000
      2.4750000000     2.4750000000     0.0000000000

ATOMIC_POSITIONS crystal
Pb   0.0000000000   0.0000000000   0.0000000000

K_POINTS automatic
  20 20 20 0 0 0
