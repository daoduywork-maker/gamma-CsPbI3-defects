&CONTROL
  calculation   = 'relax'
  prefix        = 'ref_I2_molecule'
  outdir        = './tmp'
  pseudo_dir    = '/public/home/daomduy/cspbi3/pseudo_pbesol'
  etot_conv_thr = 1.0e-06
  forc_conv_thr = 4.0e-04
  nstep         = 200
  tprnfor       = .true.
  tstress       = .true.
/

&SYSTEM
  ibrav       = 0
  nat         = 2
  ntyp        = 1
  ecutwfc     = 60.0
  ecutrho     = 480.0
  occupations = 'fixed'
  assume_isolated = 'mt'
/

&ELECTRONS
  conv_thr    = 1.0e-10
  mixing_beta = 0.3
  electron_maxstep = 300
/

&IONS
  ion_dynamics = 'bfgs'
/

ATOMIC_SPECIES
I    126.904  I.pbesol-n-kjpaw_psl.0.2.UPF

CELL_PARAMETERS angstrom
     15.0000000000     0.0000000000     0.0000000000
      0.0000000000    15.0000000000     0.0000000000
      0.0000000000     0.0000000000    15.0000000000

ATOMIC_POSITIONS crystal
I    0.5000000000   0.5000000000   0.4110000000
I    0.5000000000   0.5000000000   0.5890000000

K_POINTS gamma
