SYSTEM = gamma unit cell, dielectric tensor (DFPT)

# Electronic structure (same physics as the QE runs)
GGA      = PS              ! PBEsol
PREC     = Accurate      
ENCUT    = 500             ! eV; PAW Cs_sv, Pb_d, I
LASPH    = .TRUE.          ! non-spherical terms inside the PAW spheres
LREAL    = .FALSE.         ! Auto for the 159/160-atom cells, .FALSE. for small cells
ALGO     = Normal        
NELM     = 200           
EDIFF    = 1E-8            ! eV
ISMEAR   = 0               ! Gaussian
SIGMA    = 0.01            ! eV; insulator (QE: fixed occupations)

# Output
LWAVE    = .FALSE.       
LCHARG   = .FALSE.       

# Linear response
IBRION   = 8               ! DFPT, ionic contribution with symmetry
LEPSILON = .TRUE.          ! electronic contribution
NSW      = 1             

# Parallelisation (40 cores per std40 node)
NCORE    = 1             
KPAR     = 1               ! k-point groups, more of them is faster but uses more memory
