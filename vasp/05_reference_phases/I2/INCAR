SYSTEM = I2, variable-cell relaxation

# Electronic structure (same physics as the QE runs)
GGA      = PS              ! PBEsol
PREC     = Accurate      
ENCUT    = 500             ! eV; PAW Cs_sv, Pb_d, I
LASPH    = .TRUE.          ! non-spherical terms inside the PAW spheres
LREAL    = .FALSE.         ! Auto for the 159/160-atom cells, .FALSE. for small cells
ALGO     = Normal        
NELM     = 200           
EDIFF    = 1E-6            ! eV
ISMEAR   = 0               ! Gaussian
SIGMA    = 0.01            ! eV; insulator (QE: fixed occupations)

# Output
LWAVE    = .FALSE.       
LCHARG   = .FALSE.       

# Relaxation
IBRION   = 2             
ISIF     = 3             
NSW      = 200           
EDIFFG   = -0.01         

# Parallelisation (40 cores per std40 node)
NCORE    = 4             
KPAR     = 1               ! k-point groups; more KPAR = faster but more memory
