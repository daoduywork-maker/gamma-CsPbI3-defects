! Tight variable-cell relaxation of the 20-atom gamma-CsPbI3 cell.
! Run this first, then rebuild the supercell from its result.

&CONTROL
  calculation   = 'vc-relax'
  prefix        = 'unit_tight'
  outdir        = './tmp'
  pseudo_dir    = '/public/home/daomduy/cspbi3/pseudo_pbesol'
  etot_conv_thr = 1.0e-05
  forc_conv_thr = 4.0e-04
  nstep         = 300
  tprnfor       = .true.
  tstress       = .true.
/

&SYSTEM
  ibrav       = 0
  nat         = 20
  ntyp        = 3
  ecutwfc     = 60.0
  ecutrho     = 480.0
  occupations = 'fixed'
/

&ELECTRONS
  conv_thr    = 1.0e-09
  mixing_beta = 0.3
  electron_maxstep = 300
/

&IONS
  ion_dynamics = 'bfgs'
/

&CELL
  cell_dynamics  = 'bfgs'
  press          = 0.0
  press_conv_thr = 0.20
  cell_dofree    = 'all'
/

ATOMIC_SPECIES
Cs    132.905  cs_pbesol_v1.uspp.F.UPF
Pb    207.200  Pb.pbesol-dn-kjpaw_psl.0.2.2.UPF
I     126.904  I.pbesol-n-kjpaw_psl.0.2.UPF

